<h1>Add Student</h1>
<a href="/student_list">Student List</a>
<br><br>

<form action="/save_student" method="post">
    Enter Student Name <br>
    <input type="text" name="student_name"><br><br>
     Enter Student Mobile <br>
    <input type="number" name="student_mobile"><br><br>
     Enter Student Email <br>
    <input type="email" name="student_email"><br><br>
     Enter Student DOB <br>
    <input type="date" name="student_dob"><br><br>
     Enter Student Address <br>
     <textarea name="student_address" id=""></textarea>
     <br><br>
     <button>Add Student</button>
    
</form>