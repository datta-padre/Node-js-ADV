<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stockroom | Product list</title>
    <style>
        :root { --ink: #172121; --muted: #697473; --line: #dfe7e4; --paper: #f6f8f5; --card: #fff; --accent: #d96c45; --accent-dark: #b94d2b; --mint: #d8eee6; }
        * { box-sizing: border-box; }
        body { margin: 0; color: var(--ink); background: var(--paper); font-family: "DM Sans", "Segoe UI", sans-serif; }
        .page { width: min(1180px, calc(100% - 48px)); margin: 0 auto; padding: 38px 0 70px; }
        header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding-bottom: 52px; }
        .brand { color: #183b3b; font-size: 15px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
        .eyebrow { margin-top: 76px; color: var(--accent-dark); font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
        h1 { margin: 13px 0 0; font-size: clamp(42px, 7vw, 84px); line-height: .92; letter-spacing: -.065em; }
        .add-link { padding: 13px 18px; color: #fff; background: #183b3b; border-radius: 5px; font-size: 13px; font-weight: 800; text-decoration: none; white-space: nowrap; }
        .add-link:hover { background: #2a5956; }
        .summary { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; color: var(--muted); font-size: 13px; }
        .dot { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; }
        .table-card { overflow: hidden; background: var(--card); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 18px 45px rgba(24, 59, 59, .07); }
        .table-scroll { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; min-width: 730px; }
        th { padding: 18px 22px; color: var(--muted); background: #f7faf8; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-align: left; text-transform: uppercase; }
        td { padding: 21px 22px; border-top: 1px solid var(--line); font-size: 14px; vertical-align: middle; }
        .index { color: #a7b4b0; font-variant-numeric: tabular-nums; }
        .product-name { font-weight: 800; }
        .price { font-weight: 800; }
        .qty { display: inline-block; min-width: 32px; padding: 6px 9px; color: #286659; background: var(--mint); border-radius: 4px; font-size: 12px; font-weight: 800; text-align: center; }
        .detail { max-width: 250px; color: var(--muted); }
        .delete { color: var(--accent-dark); font-size: 12px; font-weight: 800; text-decoration: none; }
        .delete:hover { text-decoration: underline; }
        .empty { padding: 70px 30px; color: var(--muted); text-align: center; }
        .empty strong { display: block; margin-bottom: 7px; color: var(--ink); font-size: 20px; }
        @media (max-width: 620px) { .page { width: min(100% - 32px, 1180px); padding-top: 24px; } header { display: block; padding-bottom: 38px; } .eyebrow { margin-top: 55px; } .add-link { display: inline-block; margin-top: 28px; } }
    </style>
</head>
<body>
    <main class="page">
        <header>
            <div>
                <div class="brand">Stockroom / 03</div>
                <div class="eyebrow">Your current catalog</div>
                <h1>Product list</h1>
            </div>
            <a class="add-link" href="/">+ Add product</a>
        </header>
        <div class="summary"><span class="dot" aria-hidden="true"></span><%= data.length %> <%= data.length === 1 ? 'product' : 'products' %> tracked</div>
        <section class="table-card" aria-label="Product catalog">
            <% if (data.length === 0) { %>
                <div class="empty"><strong>Your catalog is waiting.</strong>Add the first product to start tracking stock.</div>
            <% } else { %>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr><th>#</th><th>Product</th><th>Price</th><th>Quantity</th><th>Details</th><th>Action</th></tr>
                        </thead>
                        <tbody>
                            <% data.forEach((item, i) => { %>
                                <tr>
                                    <td class="index"><%= String(i + 1).padStart(2, '0') %></td>
                                    <td class="product-name"><%= item.product_name %></td>
                                    <td class="price">$<%= Number(item.product_price || 0).toFixed(2) %></td>
                                    <td><span class="qty"><%= item.product_qty %></span></td>
                                    <td class="detail"><%= item.product_detail || 'No details added' %></td>
                                    <td><a class="delete" href="/delete/<%= item.id %>" onclick="return confirm('Remove this product from the catalog?')">Remove</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>